msgstr ""
"Project-Id-Version: chinese-llm\n"
"PO-Revision-Date: 2026-10-26 00:00+0000\n"
"Last-Translator: Chinese LLM contributors\n"
"Language-Team: Simplified Chinese\n"
"Language: zh_CN\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=1; plural=0;\n"

msgid "Independent Pinyin Settings"
msgstr "独立拼音设置"

msgid "Enable LLM candidates"
msgstr "启用 LLM 候选词"

msgid "Endpoint"
msgstr "接口地址"

msgid "An OpenAI compatible chat completions URL. Works with ollama, llama.cpp's llama-server, and hosted compatible APIs."
msgstr "兼容 OpenAI 的聊天补全接口地址，支持 Ollama、llama.cpp 的 llama-server 以及兼容的在线 API。"

msgid "Model"
msgstr "模型"

msgid "API Key"
msgstr "API 密钥"

msgid "Sent as a bearer token. Leave empty for a local server that does not authenticate. Falls back to the environment variable FCITX_CHINESE_LLM_API_KEY when empty."
msgstr "以 Bearer 令牌发送。不需要身份验证的本地服务可以留空；留空时会尝试使用环境变量 FCITX_CHINESE_LLM_API_KEY。"

msgid "Minimum Pinyin Length"
msgstr "最小拼音长度"

msgid "Debounce Delay (ms)"
msgstr "输入防抖延迟（毫秒）"

msgid "Request Timeout (seconds)"
msgstr "请求超时时间（秒）"

msgid "Max Candidates"
msgstr "最大候选词数量"

msgid "Candidate Position"
msgstr "候选词插入位置"

msgid "Context Length (characters)"
msgstr "上下文长度（字符）"

msgid "Cache Size"
msgstr "缓存条目数"

msgid "Errors Before Cooldown"
msgstr "进入冷却前的连续错误次数"

msgid "Cooldown (seconds)"
msgstr "冷却时间（秒）"

msgid "Show cloud marker on LLM candidates"
msgstr "在 LLM 候选词旁显示云朵标记"

msgid "Display a cloud symbol beside LLM-generated candidates. The symbol is not committed as text. Dictionary candidates are not marked, including duplicate model results."
msgstr "在 LLM 生成的候选词旁显示云朵符号，符号不会输入到正文。词库候选词不会标记，包括与模型结果重复的词库候选词。"

msgid "Mark candidates the LLM agrees with"
msgstr "标记与 LLM 一致的候选词"

msgid "Display a gear (⚙) beside a dictionary candidate when the LLM produced the same text. The symbol is not committed as text."
msgstr "当 LLM 给出与词库候选词相同的文字时，在该候选词旁显示齿轮 ⚙，符号不会输入到正文。"

msgid "Symbol for LLM candidates"
msgstr "LLM 候选词的标记符号"

msgid "Up to four characters, shown beside candidates generated by the LLM. Leave it empty to restore the default. A value that is longer, or contains a colon or a control character, is rejected and the previous symbol is kept."
msgstr "最多四个字符，显示在 LLM 生成的候选词旁。留空即恢复默认。过长，或含冒号、控制字符的值会被拒绝，并保留原来的符号。"

msgid "Symbol for agreeing candidates"
msgstr "与 LLM 一致的候选词的标记符号"

msgid "Up to four characters, shown beside a dictionary candidate that the LLM also produced. Leave it empty to restore the default. A value that is longer, or contains a colon or a control character, is rejected and the previous symbol is kept."
msgstr "最多四个字符，显示在 LLM 也给出了相同文字的词库候选词旁。留空即恢复默认。过长，或含冒号、控制字符的值会被拒绝，并保留原来的符号。"

msgid "LLM Pinyin"
msgstr "LLM拼音"

msgid "{0} was not saved"
msgstr "未保存“{0}”"

msgid "The symbol may have at most four characters."
msgstr "符号最多四个字符。"

msgid "The symbol must not contain a colon, a control character, invalid text or blanks at either end."
msgstr "符号不能含有冒号、控制字符、无效文本，两端也不能有空格。"

msgid "LLM candidates enabled"
msgstr "LLM 候选词已启用"

msgid "LLM candidates disabled"
msgstr "LLM 候选词已停用"

msgid "Click or use the toggle shortcut to enable or disable LLM candidates. Native pinyin remains available when disabled."
msgstr "点击此项或使用启用／停用快捷键切换 LLM 候选词。停用后仍可使用原生拼音。"

#, c++-format
msgid "LLM requests {0} (valid {1})"
msgstr "LLM 请求 {0}（有效 {1}）"

#, c++-format
msgid "LLM overlapping requests {0}"
msgstr "LLM 重叠请求 {0}"

#, c++-format
msgid "LLM overlap rate {0}"
msgstr "LLM 重叠率 {0}"

msgid "Requests started in this Fcitx session, including failures and cancellations. Valid requests returned usable candidates for the current input. Cache hits are not requests."
msgstr "本次 Fcitx 运行发起的请求，包括失败和取消。有效请求指返回可用候选且仍对应当前输入的请求。缓存命中不算请求。"

msgid "Valid requests with at least one candidate identical to any native candidate. Each request is counted once, before applying the candidate display limit."
msgstr "有效请求中至少一个候选与任意原生候选完全相同的请求数。每个请求只计一次，不受候选显示数量限制。"

msgid "Overlapping requests divided by valid requests. No rate is shown until a valid request completes. Statistics reset when Fcitx restarts; no input text is saved."
msgstr "重叠请求数除以有效请求数。没有有效请求时不显示比例。重启 Fcitx 后统计清零，不保存输入文本。"

msgid "Toggle Key"
msgstr "启用／停用快捷键"

msgid "System Prompt"
msgstr "系统提示词"

msgid "Keep this short and unambiguous. Output only candidate text on a single line, without explanations or echoed keys. Chinese, English, digits and emoji are supported."
msgstr "请保持简短且明确。仅在一行中输出候选文本，不要解释或回显输入按键。支持中文、英文、数字和 emoji。"

msgid "Prompt Template"
msgstr "提示词模板"

msgid "{context} is replaced with the recently committed text, {pinyin} with the keys being typed."
msgstr "{context} 会替换为最近输入并确认的文本，{pinyin} 会替换为正在输入的拼音。"

msgid "Record request history"
msgstr "记录请求历史"

msgid "Keep the last 100 requests in memory, without context or credentials. Viewing history creates a private temporary snapshot. Disable to clear history."
msgstr "在内存中保留最近 100 条请求，不记录上下文或凭据。查看历史时创建私有临时快照；停用会清空历史。"

#, c++-format
msgid "LLM request history {0}"
msgstr "LLM 请求历史 {0}"

msgid "View inputs, model replies, latency, adoption and native overlap. Opens a private local snapshot in your browser."
msgstr "查看拼音输入、模型返回、耗时、采纳情况和原生候选重叠情况，在浏览器中打开私有本地快照。"

msgid "Clear LLM request history"
msgstr "清空 LLM 请求历史"
